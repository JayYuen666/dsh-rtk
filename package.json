{
  "name": "@jayyuen66/dsh-rtk",
  "version": "0.2.0",
  "description": "dsh 输出压缩插件（rtk）：遮蔽 bash 加 rtk 前缀 + post-execute pipe 兜底 + 自记账设置卡。",
  "keywords": [
    "compression",
    "cordis",
    "dsh",
    "dsh-plugin",
    "rtk",
    "token"
  ],
  "license": "MIT",
  "author": {
    "name": "JayYuen",
    "url": "https://github.com/JayYuen666"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JayYuen666/dsh-rtk.git"
  },
  "files": [
    "icon.svg",
    "locale/zh.json",
    "locale/en.json",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "host.js",
    "client.js",
    "client.insights-echarts.js",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build:client": "node build-client.mjs",
    "build": "node build-host.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.build-scripts.json",
    "lint": "oxlint .",
    "test": "vitest run --coverage",
    "test:platform": "vitest run --coverage.enabled=false",
    "model-visible": "node scripts/model-visible.mjs",
    "check": "npm run --loglevel=warn typecheck && npm run --loglevel=warn lint && npm run --loglevel=warn build:client && npm run --loglevel=warn build && npm run --loglevel=warn test && npm run --loglevel=warn fmt:check",
    "check:platform": "npm run --loglevel=warn typecheck && npm run --loglevel=warn lint && npm run --loglevel=warn build:client && npm run --loglevel=warn build && npm run --loglevel=warn test:platform && npm run --loglevel=warn fmt:check",
    "prepack": "npm run --loglevel=warn build:client && npm run --loglevel=warn build",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "prepare": "npm run --loglevel=warn build:client && npm run --loglevel=warn build"
  },
  "dependencies": {
    "@jayyuen66/dsh-plugin-shared": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/dsh-error": "0.2.2-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-spill": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "@e18e/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "echarts": "6.1.0",
    "eslint-plugin-regexp": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-zod": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "react": "^19.3.0",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-output-retention": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-util-values": "^0.2.2-rc.2",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "icon": "icon.svg",
  "engines": {
    "dsh": "^0.2.2-rc.2",
    "node": ">=24.9.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": [
        "@jayyuen66/dsh-plugin-shared/client"
      ]
    }
  }
}
